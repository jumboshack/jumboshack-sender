# Copy this file to `ingest.env` and fill in your device token.
#   cp ingest.env.example ingest.env
#
# ingest.env is gitignored — your token never gets committed.
# Get a token at https://app.jumboshack.com/account  (add a Location, then a Device).
# The token is shown once, at creation — copy it then.

INGEST_TARGETS=cloud
INGEST_URL_cloud=https://ingest.jumboshack.com/api/ingest/geothermal
INGEST_TOKEN_cloud=jsk_your_device_token_here

# Optional: label this unit on your dashboard (defaults to "Unit N")
# JUMBOSHACK_UNIT_LOCATION=Basement heat pump

# Optional tuning:
# INGEST_SPOOL_MAX=2000     # max buffered readings per target if offline
# INGEST_TIMEOUT=10         # per-request seconds
