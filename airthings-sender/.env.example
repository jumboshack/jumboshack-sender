# Airthings → Jumboshack sender — copy to .env and fill in.
# Get the Airthings values at dashboard.airthings.com → Integrations → API:
#   create an API client (client credentials), then copy the client id/secret and your account id.
AIRTHINGS_CLIENT_ID=
AIRTHINGS_CLIENT_SECRET=
AIRTHINGS_ACCOUNT_ID=

# Your Jumboshack device token — create a device with module "air quality" on the
# Account page (app.jumboshack.com/account); the token is shown once, paste it here.
INGEST_TOKEN=

# Defaults are fine for most people:
# INGEST_URL=https://ingest.jumboshack.com/api/ingest/airquality
# POLL_INTERVAL_SECONDS=300

# First run only: set to 1 to do a dry run (validates against the server, stores nothing)
# then unset it to start streaming.
# VALIDATE=1

# Optional: label/sort floors by serial, e.g. {"2960123636":["Main Floor",2]}
# FLOOR_MAP_JSON={}
